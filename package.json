{
  "name": "mtga-deckbuilder",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "sync:cards": "tsx --env-file=apps/web/.env.local scripts/sync-scryfall.ts",
    "sync:cards:dry": "tsx --env-file=apps/web/.env.local scripts/sync-scryfall.ts --dry-run --limit=2000",
    "sync:cards:ci": "tsx scripts/sync-scryfall.ts",
    "refresh:view": "tsx --env-file=apps/web/.env.local scripts/refresh-view.ts"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.22.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0"
}
